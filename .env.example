# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
# cp .env.example .env

# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=otboo
MYSQL_DATABASE=otboo
MYSQL_USER=otboo
MYSQL_PASSWORD=otboo

# --- 애플리케이션 ---
# 값에 & 가 있으므로 반드시 따옴표로 감싼다. 안 그러면 셸에서 source 할 때 깨진다.
DB_URL="jdbc:mysql://localhost:3306/otboo?serverTimezone=UTC&characterEncoding=UTF-8&rewriteBatchedStatements=true"
DB_USERNAME=otboo
DB_PASSWORD=otboo

REDIS_HOST=localhost
REDIS_PORT=6379

# --- 피드 검색 (Elasticsearch) ---
# 켜지 않으면 MySQL(ngram FULLTEXT + LIKE) 로 검색한다. 앱은 그대로 뜬다.
# 켤 거면 먼저 `docker compose up -d elasticsearch` 로 컨테이너를 띄운다.
SEARCH_ENGINE=elasticsearch
ELASTICSEARCH_URIS=http://localhost:9200
# AWS OpenSearch 로 옮길 때는 위 URI 를 엔드포인트로 바꾸고 아래 두 줄을 채운다.
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=

# 업로드 이미지 저장 경로. 비워두면 ./data/images 를 쓴다.
STORAGE_BASE_DIR=./data/images

# --- 비공개 S3 저장 기반 (기본 비활성) ---
# Access Key를 파일에 넣지 않는다. 배포 환경에서는 ECS Task Role을 사용한다.
S3_STORAGE_ENABLED=false
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
S3_PRESIGNED_URL_TTL=15m
S3_MAX_SIZE=10485760

# --- 소셜 로그인 ---
# console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID (웹)
# 승인된 리디렉션 URI 에 http://localhost:8080/login/oauth2/code/google 를 등록한다.
# 비워두면 앱은 뜨지만 구글 버튼을 눌렀을 때 구글이 거부한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# developers.kakao.com → 내 애플리케이션 → 앱 설정/카카오 로그인
# Redirect URI 에 http://localhost:8080/login/oauth2/code/kakao 를 등록한다.
# 동의 항목에서 닉네임과 카카오계정(이메일)을 사용하도록 설정한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 외부 연동 (확정되면 채운다) ---
# WEATHER_API_KEY=
# LLM_API_KEY=
# PINTEREST_ACCESS_TOKEN=
