# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
# cp .env.example .env

# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=otboo
MYSQL_DATABASE=otboo
MYSQL_USER=otboo
MYSQL_PASSWORD=otboo

# --- 애플리케이션 ---
# 값에 & 가 있으므로 반드시 따옴표로 감싼다. 안 그러면 셸에서 source 할 때 깨진다.
DB_URL="jdbc:mysql://localhost:3306/otboo?serverTimezone=UTC&characterEncoding=UTF-8&rewriteBatchedStatements=true"
DB_USERNAME=otboo
DB_PASSWORD=otboo

REDIS_HOST=localhost
REDIS_PORT=6379

# --- 외부 연동 (확정되면 채운다) ---
# WEATHER_API_KEY=
# LLM_API_KEY=
# PINTEREST_ACCESS_TOKEN=
# AWS_S3_BUCKET=
